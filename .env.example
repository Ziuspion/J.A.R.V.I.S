# APENAS para o servidor opcional. O HTML funciona sem este arquivo e sem Python.
# Copie como .env. Nunca distribua esse arquivo com suas chaves.
# Depois de alterar, feche e reabra INICIAR_SERVIDOR_OPCIONAL.bat.
# local = geração desativada. ollama = serviço já instalado em seu próprio PC.
# openrouter | lovable | compatible = provedor externo configurado por você.
AI_PROVIDER=local
AI_PROTOCOL=
AI_AUTH=
AI_TOKEN_PARAM=
AI_SYSTEM_ROLE=system
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=
COHERE_API_KEY=
AZURE_OPENAI_API_KEY=
OPENROUTER_API_KEY=
LOVABLE_API_KEY=
AI_BASE_URL=
AI_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:1.7b

# Integrações do servidor usadas em Recursos > Pesquisa.
# Valores reais devem vir da sua conta. Nenhuma é necessária para abrir o HTML.
TAVILY_API_KEY=
NEWSAPI_KEY=
WOLFRAM_APPID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Integrações físicas opcionais. Desligadas por padrão.
JARVIS_DESKTOP_ENABLED=0
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ENTITIES=

# Provedores adicionais: escolha AI_PROVIDER e AI_MODEL.
DEEPINFRA_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=

PERPLEXITY_API_KEY=
CLOUDFLARE_API_TOKEN=
SAMBANOVA_API_KEY=
NOVITA_API_KEY=
